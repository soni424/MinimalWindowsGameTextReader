<Window x:Class="GameTextReader.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Style="{StaticResource {x:Type Window}}" Title="Game Text Reader" Width="1400" Height="900" MinWidth="640" MinHeight="540" Icon="assets/app_icon.ico" SizeChanged="WindowResized" Closing="WindowClosing">
 <DockPanel Margin="14">
  <Grid DockPanel.Dock="Top" Margin="10,2,10,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="assets/icons/app_icon_32.png" Width="30" Height="30" Margin="0,0,12,0"/><StackPanel><TextBlock Text="Game Text Reader" FontWeight="SemiBold" FontSize="20"/><TextBlock x:Name="BuildLabel" Style="{StaticResource Hint}" Margin="0,2,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ThemeToggle" Width="44" Height="38" Padding="8" Click="ThemeChanged"/><Button Content="About" Tag="help" Click="AboutClick"/></StackPanel></Grid>
  <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" x:Name="ShortcutStatus" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/></Grid></Border>
  <TabControl x:Name="MainTabs" SelectionChanged="MainTabChanged">
   <TabItem Header="Reader">
    <Grid x:Name="ReaderWorkspace" Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="CaptureSidebar" Style="{StaticResource Card}" Margin="0,0,12,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="Capture" Style="{StaticResource SectionTitle}"/><TextBlock Text="Profile" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="Profiles" DisplayMemberPath="Name" SelectionChanged="ProfileChanged"/><UniformGrid Columns="3"><Button Content="New" Tag="add" Padding="4,9" FontSize="12" Click="NewProfile"/><Button Content="Rename" Tag="edit" Padding="4,9" FontSize="12" Click="RenameProfile"/><Button Content="Delete" Tag="delete" Padding="4,9" FontSize="12" Click="DeleteProfile"/></UniformGrid><Separator Margin="0,12"/>
      <Button Content="Set capture area" Tag="capture" Click="SetArea"/><Button Content="Read fixed box" Tag="image" Click="ReadFixed" Background="{DynamicResource AccentBrush}"/><Button Content="Select a snippet" Tag="snippet" Click="SelectSnippet"/>
      <TextBlock Text="Text extraction" Margin="3,18,0,3"/><ComboBox x:Name="OcrMode" SelectionChanged="OcrModeChanged"/><TextBlock Text="Enhanced adapts small or faint text when the first pass looks weak." Style="{StaticResource Hint}"/>
      <TextBlock Text="Auto-Read speed"/><ComboBox x:Name="AutoSpeed" SelectionChanged="AutoSpeedChanged"/><TextBlock Text="Normal and Fast confirm dialogue twice. Instant reads the first usable result and recovers from growing text." Style="{StaticResource Hint}"/><Button x:Name="AutoButton" Content="Start Auto-Read" Tag="play" Click="ToggleAuto"/><TextBlock x:Name="AutoStatus" Text="Auto-Read is off." Style="{StaticResource Hint}"/>
      <Separator Margin="0,12"/><TextBlock Text="Capture area" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="AreaText" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="Snippet selection works best in borderless fullscreen. Fixed-box reading opens no selection overlay." Style="{StaticResource Hint}"/><Button Content="Stop audio" Tag="stop" Click="StopAudio"/>
     </StackPanel></ScrollViewer></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0"><DockPanel>
      <StackPanel DockPanel.Dock="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Last captured text" Style="{StaticResource SectionTitle}"/><Button Grid.Column="1" x:Name="CaptureControlsButton" Content="Capture controls" Tag="settings" Visibility="Collapsed" Click="ToggleSidebar"/></Grid><TextBlock x:Name="TextMetadata" Text="Type or paste text, or capture it from the screen." Style="{StaticResource Hint}"/></StackPanel>
      <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" VerticalAlignment="Center"><Button x:Name="PreviousButton" Content="Previous sentence" Tag="previous" Click="PreviousSentence"/><Button x:Name="PlayButton" Content="Play" Tag="play" Click="PlayPause" MinWidth="90"/><Button x:Name="NextButton" Content="Next sentence" Tag="next" Click="NextSentence"/><TextBlock Text="Speed" VerticalAlignment="Center" Margin="14,0,6,0"/><Slider x:Name="ReaderSpeed" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="110" VerticalAlignment="Center" ValueChanged="ReaderSpeedChanged"/><TextBlock x:Name="ReaderSpeedText" Text="1.0×" VerticalAlignment="Center" Margin="6"/><Button Content="1.0×" Click="ResetReaderSpeed"/><Button Content="Read Again" Tag="repeat" Background="{DynamicResource AccentBrush}" Click="ReadAgain"/><Button x:Name="CorrectionsButton" Content="Corrections" Tag="edit" Click="ShowCorrections"/><Button Content="Copy" Tag="copy" Click="CopyText"/><Button Content="Clear" Tag="delete" Click="ClearText"/></WrapPanel>
      <TabControl x:Name="DocumentTabs" SelectionChanged="DocumentTabChanged"><TabItem Header="Edit" x:Name="EditTab"><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><edit:TextEditor x:Name="Editor" WordWrap="True" ShowLineNumbers="False" FontFamily="Segoe UI" FontSize="16" Padding="16" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource TextBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" TextChanged="EditorChanged" PreviewMouseDoubleClick="EditorDoubleClick"/></Border></TabItem><TabItem Header="Preview" x:Name="PreviewTab"><Grid><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button x:Name="LoadImagesButton" Content="Load remote images" Tag="image" Visibility="Collapsed" Click="LoadImages"/><TextBlock x:Name="PreviewError" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></StackPanel><wv:WebView2CompositionControl x:Name="Preview"/></DockPanel></Grid></TabItem></TabControl>
     </DockPanel></Border>
    </Grid>
   </TabItem>
   <TabItem Header="OCR corrections"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,8">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Offline OCR correction" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="CorrectionEnabled" Content="Correct likely OCR mistakes automatically" Click="CorrectionOptionsChanged"/><ComboBox x:Name="CorrectionStrength" Width="220" HorizontalAlignment="Left" SelectionChanged="CorrectionStrengthChanged"/><TextBlock Text="Custom rules still apply when automatic correction is off. Uncertain changes remain in Needs review." Style="{StaticResource Hint}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Custom replacements" Style="{StaticResource SectionTitle}"/><WrapPanel DockPanel.Dock="Bottom"><Button Content="Add rule" Tag="add" Click="AddRule"/><Button Content="Edit rule" Tag="edit" Click="EditRule"/><Button Content="Delete rule" Tag="delete" Click="DeleteRule"/></WrapPanel><ListBox x:Name="Rules" MinHeight="160" MaxHeight="300" MouseDoubleClick="RuleDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="8"><TextBlock Text="{Binding Original}" FontWeight="SemiBold" Width="220"/><TextBlock Text=" → " Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Replacement}" Width="260"/><TextBlock Text="{Binding Enabled, StringFormat=Enabled: {0}}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Protected game terms" Style="{StaticResource SectionTitle}"/><TextBlock Text="One name or term per line. These are never changed automatically." Style="{StaticResource Hint}"/><TextBox x:Name="ProtectedTerms" AcceptsReturn="True" Height="140" VerticalScrollBarVisibility="Auto"/><Button Content="Save protected terms" Tag="save" HorizontalAlignment="Left" Click="SaveProtected"/><CheckBox x:Name="DebugLogging" Content="Enable optional OCR and performance debug logging" Click="CorrectionOptionsChanged"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Voice &amp; shortcuts"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="VoiceWorkspace" Margin="0,8">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="VoiceCard" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Voice" Style="{StaticResource SectionTitle}"/><TextBlock Text="Installed voice"/><ComboBox x:Name="Voices" DisplayMemberPath="Name" SelectionChanged="VoiceChanged"/><TextBlock x:Name="VoiceCount" Style="{StaticResource Hint}"/><TextBlock x:Name="BaseSpeedLabel" Text="Base speed: 0"/><Slider x:Name="BaseSpeed" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BaseVoiceChanged" Margin="5,8"/><TextBlock x:Name="VolumeLabel" Text="Volume: 100"/><Slider x:Name="Volume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BaseVoiceChanged" Margin="5,8"/><TextBlock Text="New capture while speaking" Margin="0,10,0,3"/><ComboBox x:Name="SpeechMode" SelectionChanged="SpeechModeChanged"/><TextBlock Text="Maximum overlapping voices" Margin="0,10,0,3"/><ComboBox x:Name="MaxOverlap" SelectionChanged="SpeechModeChanged"/><Button Content="Test selected voice" Tag="voice" Click="TestVoice"/><TextBlock Text="Previews use a maximum volume of 60%." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Border>
    <Border x:Name="ShortcutCard" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Global shortcuts" Style="{StaticResource SectionTitle}"/><TextBlock Text="Record a combination, then Apply shortcuts. The status bar shows active shortcuts." Style="{StaticResource Hint}"/>
     <Grid x:Name="ShortcutGrid"/><TextBlock x:Name="PendingShortcuts" Style="{StaticResource Hint}"/><Button Content="Apply shortcuts" Tag="check" Click="ApplyShortcuts"/></StackPanel></Border>
    <Border x:Name="UtilitiesCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Windows startup" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/><CheckBox x:Name="StartupEnabled" Content="Launch when I sign in to Windows" Click="StartupChanged"/><TextBlock Text="Starts quietly in the tray, with shortcuts ready." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="1" x:Name="UtilityActions" VerticalAlignment="Center"><Button Content="Import settings from older app folder…" Tag="folder" Click="ImportSettings"/><Button Content="Hide settings to tray" Tag="settings" Click="HideToTray"/></WrapPanel></Grid></Border>
   </Grid></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
